APP_NAME=market-data-service
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/market_data

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=price-events
KAFKA_GROUP_ID=moving-average-consumer

REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=true
CACHE_TTL_SECONDS=15

DEFAULT_PROVIDER=yahoo
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RATE_LIMIT_PER_MINUTE=2
PROVIDER_HTTP_MAX_RETRIES=2
PROVIDER_HTTP_BACKOFF_SECONDS=1.5
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

POLL_DEFAULT_INTERVAL_SECONDS=60
POLL_MIN_INTERVAL_SECONDS=15
POLL_MAX_SYMBOLS_PER_JOB=20

WORKER_METRICS_PORT=9108
